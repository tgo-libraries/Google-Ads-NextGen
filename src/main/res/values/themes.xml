<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="tgo_Theme.NativesApplications" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/tgo_purple_500</item>
        <item name="colorPrimaryVariant">@color/tgo_purple_700</item>
        <item name="colorOnPrimary">@color/tgo_white</item>
        <item name="colorSecondary">@color/tgo_teal_200</item>
        <item name="colorSecondaryVariant">@color/tgo_teal_700</item>
        <item name="colorOnSecondary">@color/tgo_black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="tgo_AdTheme" >
        <item name="android:background">@color/tgo_black</item>
        <item name="android:windowBackground">@color/tgo_black</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


</resources>